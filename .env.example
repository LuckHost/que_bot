# Скопируйте в .env и заполните. .env не коммитится.

# Токен бота от @BotFather (обязательно)
TOKEN=123456789:replace-with-your-token

# Telegram id администраторов через запятую (обязательно).
# Первому из списка бот пишет о запуске/остановке.
ADMIN_ID=111111111,222222222

# Таймзона пользователей: в ней задаётся время отложенных очередей (необязательно)
BOT_TIMEZONE=Asia/Krasnoyarsk

# Уровень логирования: DEBUG, INFO, WARNING, ERROR (необязательно, по умолчанию INFO)
LOG_LEVEL=INFO
